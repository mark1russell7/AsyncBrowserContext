{
  "name": "async-browser-context",
  "version": "0.1.0",
  "description": "AsyncLocalStorage and the TC39 AsyncContext API (Variable, Snapshot) for browsers. The context stays through await, promises, timers, events and generators. A Babel preset and a Vite plugin transform async functions. On Node.js, the package uses the native AsyncLocalStorage.",
  "license": "MIT",
  "author": "Mark Russell",
  "homepage": "https://mark1russell7.github.io/AsyncBrowserContext/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/AsyncBrowserContext.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/AsyncBrowserContext/issues"
  },
  "keywords": [
    "asynclocalstorage",
    "async-local-storage",
    "asynccontext",
    "async-context",
    "async-context-polyfill",
    "tc39",
    "proposal-async-context",
    "polyfill",
    "browser",
    "context",
    "context-propagation",
    "continuation-local-storage",
    "cls",
    "async-hooks",
    "zone",
    "zone.js",
    "request-context",
    "request-id",
    "correlation-id",
    "tracing",
    "opentelemetry",
    "logging",
    "await",
    "promise",
    "babel-preset",
    "babel-plugin",
    "vite-plugin",
    "vite",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/runtime.js",
    "./dist/install.js",
    "./dist/patches/*.js",
    "./src/index.ts",
    "./src/runtime.ts",
    "./src/install.ts",
    "./src/patches/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser/runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "node": "./dist/node/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry.d.ts",
      "node": "./dist/node/opentelemetry.js",
      "default": "./dist/opentelemetry.js"
    },
    "./babel-preset": {
      "types": "./dist/babel/preset.d.ts",
      "default": "./dist/babel/preset.js"
    },
    "./vite": {
      "types": "./dist/vite/plugin.d.ts",
      "default": "./dist/vite/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-*",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:node": "vitest run --project unit --project \"rules (browser runtime, Node.js)\" --project \"rules (node runtime)\" --project \"rules (node runtime, no transform)\"",
    "test:browser": "vitest run --project \"browser (chromium)\" --project \"browser (firefox)\" --project \"browser (webkit)\"",
    "coverage": "vitest run --coverage --project unit --project \"rules (browser runtime, Node.js)\" --project \"rules (node runtime)\"",
    "mutation": "stryker run",
    "bench": "pnpm build && tsx bench/run.ts",
    "smoke": "pnpm build && tsx test/smoke/run.ts",
    "lint:ste": "tsx tools/ste-lint/src/cli.ts",
    "site:dev": "pnpm --filter ./site dev",
    "site:build": "pnpm --filter ./site build",
    "prepublishOnly": "pnpm build && pnpm test",
    "site:data": "tsx scripts/site-data.ts",
    "readme:media": "tsx scripts/readme-media.ts"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@babel/helper-module-imports": "^8.0.0",
    "@babel/plugin-transform-async-generator-functions": "^8.0.6",
    "@babel/plugin-transform-async-to-generator": "^8.0.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^25.3.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "playwright": "^1.64.0",
    "tinybench": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
