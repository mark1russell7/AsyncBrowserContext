{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedDeclarations": false,
    "types": [
      "node",
      "vitest/globals",
      "@vitest/browser-playwright"
    ],
    "paths": {
      "async-browser-context": [
        "./src/index.ts"
      ],
      "async-browser-context/runtime": [
        "./src/runtime.ts"
      ],
      "async-browser-context/browser": [
        "./src/index.ts"
      ],
      "async-browser-context/vite": [
        "./src/vite/plugin.ts"
      ],
      "async-browser-context/babel-preset": [
        "./src/babel/preset.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*.ts",
    "bench/**/*.ts",
    "vitest.config.ts",
    "stryker.config.mjs"
  ],
  "exclude": [
    "test/legacy/**",
    "test/smoke/fixture/**"
  ]
}
